DATABASE_URL="file:./dev.db"

# Option 1: Anthropic Claude (if you have an API key)
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Option 2: Open-source local LLM via Ollama
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:14b"

# Scene image generation (open model via Hugging Face Inference)
HUGGINGFACE_API_KEY="hf_..."
HUGGINGFACE_IMAGE_MODEL="black-forest-labs/FLUX.1-schnell"

# Legacy (optional)
BLOCKADE_LABS_API_KEY="your-blockade-labs-api-key"
REPLICATE_API_TOKEN="your-replicate-api-token"
